/* ═══════════════════════════════════════════════════════════════════════════ */
/* colours.rasi  —  generated by wallust, do not edit                          */
/*                                                                             */
/* Every theme in ~/.config/rofi/themes/ starts with `@import "colours.rasi"`   */
/* and uses these names, so the whole rofi surface follows the wallpaper.       */
/* Edit wallust/templates/rofi.rasi in the repo instead of this file.           */
/* ═══════════════════════════════════════════════════════════════════════════ */

* {
    /* bg1 is a faint accent wash rather than {{color0}}: on many wallpapers
       wallust resolves color0 to the same value as {{background}}, which would
       flatten the inputbar into the body. A low-alpha accent always separates. */
    bg0:         {{background}}f2;
    bg1:         {{color4}}1a;
    border-col:  {{color8}};
    fg0:         {{foreground}};
    fg1:         {{color7}};
    accent:      {{color4}};
    urgent:      {{color1}};
    selected-bg: {{color5}}40;
    font:        "JetBrainsMono Nerd Font 12";
}
